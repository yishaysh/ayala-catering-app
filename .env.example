# Server-only Environment Variables (NEVER prefix secrets with VITE_)
# Copy to .env.local for local development and configure in Vercel Project Settings -> Environment Variables.

# 1. PostgreSQL / Neon (use a least-privilege application role where possible)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# 2. Admin Authentication & Session Signing (server-only)
# Generate ADMIN_PASSWORD_HASH with: node -e "const c=require('crypto'),s=c.randomBytes(16).toString('hex');console.log('scrypt$'+s+'$'+c.scryptSync('CHANGE_ME',s,64).toString('hex'))"
ADMIN_PASSWORD_HASH=scrypt$REPLACE_SALT$REPLACE_HASH
# Optional legacy/dev fallback if ADMIN_PASSWORD_HASH is unset (prefer ADMIN_PASSWORD_HASH in production):
# ADMIN_PASSWORD=replace_with_strong_admin_password
# Generate SESSION_SECRET with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_with_64_hex_char_random_secret

# 3. Gemini AI Menu Planner (server-only)
GEMINI_API_KEY=replace_with_rotated_gemini_api_key
# Set to a model confirmed available for this project/API (e.g. gemini-2.5-flash)
GEMINI_MODEL=

# 4. Cloudinary Media Uploads (server-only signed upload params; public URLs stay unsigned)
CLOUDINARY_CLOUD_NAME=md6mhfhd
CLOUDINARY_API_KEY=replace_with_rotated_cloudinary_api_key
CLOUDINARY_API_SECRET=replace_with_rotated_cloudinary_api_secret

# 5. Server-side Quote Email Notifications (never exposed to browser)
NOTIFICATION_EMAIL=
CONTACT_EMAIL=
# Option A: Resend HTTPS API (recommended)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Ayala Catering <quotes@your-verified-domain.com>
# Option B: Signed Webhook URL
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_SECRET=

# 6. Canonical Site Origin
SITE_URL=https://ayala-catering-app.vercel.app/
