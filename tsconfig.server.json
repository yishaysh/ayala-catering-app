{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true
  },
  "include": [
    "shared/**/*",
    "server/**/*",
    "api/**/*",
    "tests/**/*"
  ],
  "exclude": ["node_modules", "dist"]
}
